        <mxCell id="title" value="&lt;b&gt;Figure R1: Selective Segmentation System Architecture (Component A)&lt;/b&gt;&lt;br&gt;Post-Hoc Uncertainty Quantification and Validation-Calibrated Selective Prediction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;fontColor=#ffffff;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1360" height="50" as="geometry" />
        </mxCell>
        <!-- Stage 1 -->
        <mxCell id="r1_s1" value="&lt;b&gt;STAGE 1: INPUTS&lt;/b&gt;&lt;hr&gt;• Ultrasound Scan X_v (256x256)&lt;br&gt;• Text Prompt X_t&lt;br&gt;• Intensity normalized [0, 1]&lt;br&gt;• Ground truth DECOUPLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="90" width="220" height="700" as="geometry" />
        </mxCell>
        <!-- Stage 2 -->
        <mxCell id="r1_s2" value="&lt;b&gt;STAGE 2: ORIGINAL MedCLIPSeg (FROZEN)&lt;/b&gt;&lt;hr&gt;• Parallel ViT-B/16 &amp; Text Encoders&lt;br&gt;• PVL Cross-Attention Adapters&lt;br&gt;• V_sample = V_μ + ε ⊙ V_σ (p=0.20)&lt;br&gt;• Monte Carlo T=30 passes&lt;br&gt;• Outputs: Mask Ŷ and Entropy ℋ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#5eead4;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="320" height="700" as="geometry" />
        </mxCell>
        <!-- Stage 3 -->
        <mxCell id="r1_s3" value="&lt;b&gt;STAGE 3: SELECTIVE DECISION (OUR WORK)&lt;/b&gt;&lt;hr&gt;• Spatial Stencil Ω_fg = { (x,y) | Ŷ == 1 }&lt;br&gt;• Lesion Present: U_fg ≤ τ* (0.064058)&lt;br&gt;• Empty Mask: U_mean ≤ τ_neg (1e-4)&lt;br&gt;• Outcomes: ACCEPTED vs REVIEW REQUIRED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fde047;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="90" width="370" height="700" as="geometry" />
        </mxCell>
        <!-- Stage 4 -->
        <mxCell id="r1_s4" value="&lt;b&gt;STAGE 4: OUTPUTS &amp; EVALUATION&lt;/b&gt;&lt;hr&gt;• Runtime: Tri-Modal Overlay + Status&lt;br&gt;• Accepted != Proof of Accuracy&lt;br&gt;• Offline: Ground Truth Y, DSC, NSD,&lt;br&gt;  Failure AUROC, Risk-Coverage AURC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="990" y="90" width="390" height="700" as="geometry" />
        </mxCell>
        <!-- Connections -->
